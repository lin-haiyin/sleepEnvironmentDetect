CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# COM7 is the CH343 UART connected to the board console.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_ROM_SERIAL_PORT_NUM=0
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG is not set
# Sensor bring-up does not need PSRAM. It is disabled because this board repeatedly
# hits RTCWDT after PSRAM is added to the heap; re-enable only after board-level diagnosis.
# CONFIG_SPIRAM is not set
